[codespell]
# skipping compiled javascript code
skip = 	./.git,./BenchExec.egg-info,
		./benchexec/tablegenerator/react-table/build,
		./benchexec/tablegenerator/react-table/node_modules,
		*.min.js,package-lock.json,*.snap,
		./benchexec/tablegenerator/test_integration/results,
		./benchexec/tablegenerator/test_integration/expected

ignore-words-list = aprove,grat,notin,Donig,te,infor,wit,othe